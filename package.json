{
  "name": "rescript-relude",
  "description": "Alternative standard library (prelude) for ReasonML",
  "homepage": "https://github.com/reazen/relude",
  "bugs": "https://github.com/reazen/relude/issues",
  "version": "0.66.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/reazen/relude.git"
  },
  "type": "module",
  "packageManager": "yarn@4.7.0",
  "scripts": {
    "clean": "rescript clean",
    "build": "rescript build",
    "watch": "rescript build -w",
    "test": "jest",
    "coverage": "npm run test",
    "docs": "docsify serve ./docs",
    "cleanbisect": "rm bisect*.coverage || true",
    "cleanbuild": "npm run clean && npm run build",
    "cleanwatch": "npm run clean && npm run watch",
    "cleantest": "npm run cleanbuild && npm run test",
    "cleancoverage": "npm run cleanbisect && BISECT_ENABLE=yes npm run cleanbuild && npm run coverage",
    "releasebuild": "npm run cleancoverage"
  },
  "keywords": [
    "ReasonML",
    "Melange",
    "Utility",
    "Prelude",
    "Standard Library"
  ],
  "author": "",
  "license": "MIT",
  "jest": {
    "verbose": true,
    "testMatch": [
      "**/__tests__/*_test.res.mjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/testUtils/"
    ],
    "transform": {
      "^.+\\.m?jsx?$": "@swc/jest"
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!(rescript|@rescript/core|@glennsl/rescript-jest|rescript-bastet)/)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "mjs"
    ]
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "github:dsiu/rescript-jest#rescript-v12",
    "@swc/core": "^1.10.4",
    "@swc/jest": "^0.2.37",
    "docsify-cli": "~4.4.0",
    "jest": "^29.7.0",
    "rescript": "^12.0.0-alpha.12",
    "rescript-bastet": "github:dsiu/rescript-bastet#rescript-v12"
  },
  "peerDependencies": {
    "rescript": "^12.0.0-alpha.12",
    "rescript-bastet": "*"
  },
  "dependencies": {
    "bisect_ppx": "^2.7.1"
  }
}
