{
  "name": "rescript-relude",
  "description": "Alternative standard library (prelude) for ReasonML",
  "homepage": "https://github.com/reazen/relude",
  "bugs": "https://github.com/reazen/relude/issues",
  "version": "0.66.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/reazen/relude.git"
  },
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "clean": "rescript clean",
    "build": "rescript build",
    "watch": "rescript watch",
    "test": "jest",
    "coverage": "jest --coverage",
    "docs": "docsify serve ./docs",
    "cleanbisect": "rm bisect*.coverage || true",
    "cleanbuild": "npm run clean && npm run build",
    "cleanwatch": "npm run clean && npm run watch",
    "cleantest": "npm run cleanbuild && npm run test",
    "cleancoverage": "npm run cleanbisect && BISECT_ENABLE=yes npm run cleanbuild && npm run coverage",
    "releasebuild": "npm run cleancoverage"
  },
  "keywords": [
    "ReasonML",
    "Melange",
    "Utility",
    "Prelude",
    "Standard Library"
  ],
  "author": "",
  "license": "MIT",
  "jest": {
    "verbose": true,
    "testMatch": [
      "<rootDir>/__tests__/**/*_test.res.mjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/testUtils/"
    ],
    "transform": {
      "^.+\\.m?jsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!(rescript|@rescript/runtime|@glennsl/rescript-jest|rescript-bastet)/)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "mjs"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@glennsl/rescript-jest": "github:dsiu/rescript-jest#rescript-v12-wip",
    "babel-jest": "^27.3.1",
    "docsify-cli": "~4.4.0",
    "jest": "^27.3.1",
    "rescript": "^12.1.0",
    "rescript-bastet": "github:dsiu/rescript-bastet#rescript-v12"
  },
  "peerDependencies": {
    "rescript": "^12.1.0",
    "rescript-bastet": "*"
  },
  "dependencies": {
    "bisect_ppx": "^2.7.1"
  }
}
